# Copia este fichero a .env y sustituye la contraseña antes de desplegar.
# Usa un valor largo y URL-safe, por ejemplo: openssl rand -hex 32
POSTGRES_USER=tradearena
POSTGRES_PASSWORD=replace-with-a-long-url-safe-secret
POSTGRES_DB=tradearena

# La API solo escucha en localhost por defecto. En un servidor público debe
# quedar detrás de un proxy TLS; cambia a 0.0.0.0 solo de forma deliberada.
TRADEARENA_BIND_ADDRESS=127.0.0.1
TRADEARENA_PORT=8080
TRADEARENA_IMAGE=tradearena:local
