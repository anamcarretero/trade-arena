# Copia este fichero a .env y sustituye la contraseña antes de desplegar.
# Usa un valor largo y URL-safe, por ejemplo: openssl rand -hex 32
POSTGRES_USER=tradearena
POSTGRES_PASSWORD=replace-with-a-long-url-safe-secret
POSTGRES_DB=tradearena

# La API solo escucha en localhost por defecto. En un servidor público debe
# quedar detrás de un proxy TLS; cambia a 0.0.0.0 solo de forma deliberada.
TRADEARENA_BIND_ADDRESS=127.0.0.1
TRADEARENA_PORT=8080
TRADEARENA_IMAGE=tradearena:local
TRADEARENA_WEB_IMAGE=tradearena-web:local

# Solo desarrollo local. Usa "fixture" para pruebas deterministas o "yahoo"
# para completar valoraciones históricas sin acoplar los casos de uso al proveedor.
# Yahoo no está autorizado para el despliegue público de TradeArena.
MARKET_DATA_PROVIDER=fixture

# Aplicación Regular Web de Auth0 en el tenant europeo. Estos valores son
# exclusivamente de ejemplo: AUTH0_CLIENT_SECRET nunca se expone como NEXT_PUBLIC_*.
AUTH0_DOMAIN=replace.eu.auth0.com
AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-client-secret
APP_BASE_URL=http://localhost:3000

# Genera valores independientes con:
# openssl rand -hex 32
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
BFF_SHARED_SECRET=replace-with-an-independent-32-byte-secret
SESSION_ENCRYPTION_KEY=replace-with-32-base64url-bytes
TRADEARENA_WEB_BIND_ADDRESS=127.0.0.1
TRADEARENA_WEB_PORT=3000
